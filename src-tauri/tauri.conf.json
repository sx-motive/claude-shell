{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Shell",
  "version": "0.2.7",
  "identifier": "com.github.sxmotive.claude-shell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Claude Shell",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 400,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": [10, 10, 11, 255]
      },
      {
        "label": "overlay",
        "title": "Claude Shell Toast",
        "url": "index.html#overlay",
        "width": 360,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "fullscreen": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "backgroundColor": [0, 0, 0, 0]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sx-motive/claude-shell/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3RjhCRjc3MzkyRjVFMTYKUldRV1hpODVkNy80eC9xSnlaRTFsN2drejIrL2NORzlFU0ZIYmtQbFMvN0RUcVJMVFVGNW9BSmsK"
    }
  }
}
